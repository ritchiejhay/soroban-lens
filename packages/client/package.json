{
  "name": "@soroban-lens/client",
  "version": "0.1.0",
  "description": "Typed TypeScript client for the soroban-lens query API, generated from packages/api/openapi.json.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "generate": "openapi-typescript ../api/openapi.json -o src/schema.d.ts",
    "check-version": "node scripts/check-version.mjs",
    "build": "node init && npm run generate && npm run check-version && tsc -p tsconfig.json"
  },
  "dependencies": {
    "openapi-fetch": "0.13.8"
  },
  "devDependencies": {
    "openapi-typescript": "7.8.0",
    "typescript": "^5.9.2"
  }
}
